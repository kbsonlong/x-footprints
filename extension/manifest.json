{
  "manifest_version": 2,
  "name": "X Footprints",
  "version": "1.0.0",
  "description": "Keep a local history of X posts you visit.",
  "permissions": ["storage", "alarms", "https://*/*"],
  "content_security_policy": "script-src 'self'; object-src 'self'; img-src 'self' data: https://pbs.twimg.com",
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://*.x.com/*", "*://twitter.com/*", "*://*.twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_title": "X Footprints",
    "default_popup": "popup.html"
  }
}
